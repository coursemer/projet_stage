# Connexion Microsoft (Entra ID / Azure AD) pour le dashboard Streamlit.
# Copier ce fichier en .env et remplir avec les valeurs de votre App registration
# (Azure Portal > Microsoft Entra ID > App registrations).
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
AZURE_REDIRECT_URI=http://localhost:8501

# Notifications existantes (webhook Teams / SMTP Outlook), inchangées.
TEAMS_WEBHOOK_URL=
# messagecard = connecteur Incoming Webhook classique ; simple = flux Power Automate personnalisé
TEAMS_WEBHOOK_FORMAT=messagecard
OUTLOOK_SMTP_USER=
OUTLOOK_SMTP_PASSWORD=
OUTLOOK_RECIPIENTS=

# Explications LLM des anomalies — laisse vide pour retomber sur Ollama local
# puis un template statique (voir spark/metrics/llm_explainer.py)
MISTRAL_API_KEY=
